public class GamingConsoleReport {
    public static void main(String[] args) {

        String[] cities = {"CAPE TOWN", "PORT ELIZABETH", "PRETORIA"};
        String[] consoles = {"PS5", "XBOX", "SWITCH"};

        int[][] console = {
                {1000, 2000, 3000},
                {2000, 3000, 4000},
                {1500, 1100, 1200}
        };

        int[] citySalesTotal = new int[cities.length];
        int maxSales = -1;
        String topCity = "";

        // Calculate sales totals for each city & determine top city dynamically
        for (int i = 0; i < cities.length; i++) {
            int total = 0;
            for (int j = 0; j < console[i].length; j++) {
                total += console[i][j];
            }
            citySalesTotal[i] = total;

            if (total > maxSales) {
                maxSales = total;
                topCity = cities[i];
            }
        }

        // Output Header & Console Matrix
        System.out.println("--------------------------------------------------");
        System.out.println("GAMING CONSOLE REPORT");
        System.out.println("--------------------------------------------------");
        System.out.printf("%-16s%-10s%-10s%-10s%n", "", consoles[0], consoles[1], consoles[2]);

        for (int i = 0; i < cities.length; i++) {
            System.out.printf("%-16s%-10d%-10d%-10d%n",
                    cities[i], console[i][0], console[i][1], console[i][2]);
        }

        // Output City Totals Report
        System.out.println("--------------------------------------------------");
        System.out.println("CONSOLE SALES TOTALS FOR EACH CITY");
        System.out.println("--------------------------------------------------");

        for (int i = 0; i < cities.length; i++) {
            System.out.printf("%-16s%-8d%n", cities[i], citySalesTotal[i]);
        }

        System.out.println("--------------------------------------------------");
        System.out.printf("CITY WITH MOST SALES : %s%n", topCity);
        System.out.println("--------------------------------------------------");
    }
}
